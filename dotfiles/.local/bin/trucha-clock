#!/usr/bin/env python3
"""trucha-clock — reloj grande de bloques para la terminal (Trucha OS! · Crimson Ink).
Hora en hueso, minutos en carmesí y la fecha debajo. Se adapta al tamaño de la ventana. Ctrl+C para salir."""
import os
import shutil
import signal
import sys
import time

FONT = {
    "0": ["01110", "10001", "10011", "10101", "11001", "10001", "01110"],
    "1": ["00100", "01100", "00100", "00100", "00100", "00100", "01110"],
    "2": ["01110", "10001", "00001", "00010", "00100", "01000", "11111"],
    "3": ["11110", "00001", "00001", "01110", "00001", "00001", "11110"],
    "4": ["00010", "00110", "01010", "10010", "11111", "00010", "00010"],
    "5": ["11111", "10000", "11110", "00001", "00001", "10001", "01110"],
    "6": ["00110", "01000", "10000", "11110", "10001", "10001", "01110"],
    "7": ["11111", "00001", "00010", "00100", "01000", "01000", "01000"],
    "8": ["01110", "10001", "10001", "01110", "10001", "10001", "01110"],
    "9": ["01110", "10001", "10001", "01111", "00001", "00010", "01100"],
    ":": ["00000", "00100", "00100", "00000", "00100", "00100", "00000"],
}
BONE = "\033[38;2;236;232;228m"
CRIMSON = "\033[38;2;229;56;59m"
ASH = "\033[38;2;106;106;114m"
RESET = "\033[0m"
DIAS = ["lunes", "martes", "miércoles", "jueves", "viernes", "sábado", "domingo"]
MESES = ["enero", "febrero", "marzo", "abril", "mayo", "junio", "julio",
         "agosto", "septiembre", "octubre", "noviembre", "diciembre"]


def render(text, scale):
    """Devuelve las líneas del texto en bloques; cada píxel ocupa (2*scale) columnas x scale filas."""
    rows = []
    for r in range(7):
        line = ""
        for i, ch in enumerate(text):
            color = CRIMSON if i >= 3 else BONE  # HH en hueso, :MM en carmesí
            if ch == ":":
                color = CRIMSON
            px = "".join(("█" * 2 * scale) if b == "1" else (" " * 2 * scale) for b in FONT[ch][r])
            line += color + px + "  " * scale
        for _ in range(scale):
            rows.append(line + RESET)
    return rows


def main():
    sys.stdout.write("\033[?25l")  # oculta el cursor
    signal.signal(signal.SIGINT, lambda *_: (sys.stdout.write("\033[?25h\033[0m\033[2J\033[H"), sys.exit(0)))
    last = None
    while True:
        cols, lines = shutil.get_terminal_size((80, 24))
        now = time.localtime()
        key = (time.strftime("%H:%M", now), cols, lines)
        if key != last:
            last = key
            text = key[0]
            glyph_w = 6 * len(text)  # 5 píxeles + 1 de separación
            scale = max(1, min((cols - 2) // (glyph_w * 2), (lines - 4) // 8))
            art = render(text, scale)
            width = glyph_w * 2 * scale
            date = f"{DIAS[now.tm_wday]} {now.tm_mday} de {MESES[now.tm_mon - 1]} · {now.tm_year}"
            top = max(0, (lines - len(art) - 2) // 2)
            pad = " " * max(0, (cols - width) // 2)
            out = ["\033[2J\033[H", "\n" * top]
            out += [pad + row + "\n" for row in art]
            out.append("\n" + " " * max(0, (cols - len(date)) // 2) + ASH + date + RESET)
            sys.stdout.write("".join(out))
            sys.stdout.flush()
        time.sleep(1)


if __name__ == "__main__":
    os.environ.setdefault("TERM", "xterm-256color")
    main()
