#!/usr/bin/env python3
"""trucha-copilot-app — Trucha Copilot en ventana: chats con historial y memoria, y su mascota.

  trucha-copilot-app                  abre la ventana (o la trae al frente si ya está abierta)
  trucha-copilot-app --ask "pregunta" abre un chat nuevo con esa pregunta

GTK 3 + WebKitGTK: la interfaz es HTML local (~/.local/share/trucha-os/copilot) y no carga nada de fuera.
La búsqueda y el modelo son los de trucha-copilot. Chats en ~/.local/state/trucha-os/copilot-chats.db."""
import importlib.machinery
import importlib.util
import json
import sqlite3
import sys
import threading
import time
import traceback
import urllib.parse
from pathlib import Path

HOME = Path.home()
CHATS = HOME / ".local/state/trucha-os/copilot-chats.db"
WEB = HOME / ".local/share/trucha-os/copilot"
THEME = HOME / ".config/trucha-os/current.json"
APP_ID = "es.trucha.Copilot"
DEFAULT_THEME = {"accent": "#e5383b", "accentBright": "#ff5a5f", "accentDark": "#a32a2c", "bone": "#ece8e4",
                 "ash": "#8a8580", "surface": "#0c0c0e", "card": "#1c1c20", "track": "#2a2a30", "kanji": "鱒"}
TITLE_CHARS = 60
CONFUSED = "no está en tus apuntes"

# la búsqueda y el modelo viven en trucha-copilot, junto a este script
_loader = importlib.machinery.SourceFileLoader("trucha_copilot", str(Path(__file__).resolve().with_name("trucha-copilot")))
_spec = importlib.util.spec_from_loader("trucha_copilot", _loader)
tc = importlib.util.module_from_spec(_spec)
_loader.exec_module(tc)


# ── chats ──────────────────────────────────────────────────────────────────
def store():
    CHATS.parent.mkdir(parents=True, exist_ok=True)
    db = sqlite3.connect(CHATS)
    db.executescript("""
        PRAGMA foreign_keys = ON;
        CREATE TABLE IF NOT EXISTS chats(id INTEGER PRIMARY KEY, title TEXT, updated REAL);
        CREATE TABLE IF NOT EXISTS messages(id INTEGER PRIMARY KEY,
            chat INTEGER REFERENCES chats(id) ON DELETE CASCADE,
            role TEXT, content TEXT, thinking TEXT, sources TEXT);""")
    return db


def list_chats(db):
    return [{"id": i, "title": t} for i, t in db.execute("SELECT id, title FROM chats ORDER BY updated DESC")]


def messages(db, chat):
    rows = db.execute("SELECT role, content, thinking, sources FROM messages WHERE chat = ? ORDER BY id", (chat,))
    return [{"role": r, "content": c, "thinking": t or "", "sources": json.loads(s or "{}")} for r, c, t, s in rows]


def new_chat(db, question):
    title = " ".join(question.split())
    title = title if len(title) <= TITLE_CHARS else title[:TITLE_CHARS - 1] + "…"
    chat = db.execute("INSERT INTO chats(title, updated) VALUES (?, ?)", (title, time.time())).lastrowid
    db.commit()
    return chat


def add_message(db, chat, role, content, thinking="", sources=None):
    db.execute("INSERT INTO messages(chat, role, content, thinking, sources) VALUES (?, ?, ?, ?, ?)",
               (chat, role, content, thinking, json.dumps(sources or {}, ensure_ascii=False)))
    db.execute("UPDATE chats SET updated = ? WHERE id = ?", (time.time(), chat))
    db.commit()


def delete_chat(db, chat):
    db.execute("DELETE FROM chats WHERE id = ?", (chat,))
    db.commit()


def run_turn(chat, question, think, emit, cancelled=lambda: False):
    """Responde un mensaje del chat. emit(evento, datos) avisa a la interfaz: searched, thinking,
    content, done o error. El modelo ve los últimos turnos; la búsqueda usa también la pregunta anterior."""
    db = store()
    history = [(m["role"], m["content"]) for m in messages(db, chat)]
    add_message(db, chat, "user", question)
    try:
        index = tc.connect()
        tc.update(index)
        prev = next((text for role, text in reversed(history) if role == "user"), "")
        hits = tc.search(index, f"{prev}\n{question}" if prev else question)
        if not hits:
            raise SystemExit(f"El índice está vacío: no hay notas en {tc.VAULT}")
        emit("searched", [h[2] for h in hits])
        answer = thinking = ""
        stream = tc.chat(tc.build_messages(hits, question, history), think)
        for kind, text in stream:
            if cancelled():
                break
            if kind == "thinking":
                thinking += text
            else:
                answer += text
            emit(kind, text)
        stream.close()
        used = tc.cited(answer, len(hits))
        sources = {"cited": bool(used),
                   "items": [{"n": i, "head": hits[i - 1][2], "path": hits[i - 1][1]}
                             for i in used or range(1, len(hits) + 1)]}
        add_message(db, chat, "assistant", answer, thinking, sources)
        emit("done", {"sources": sources, "confused": CONFUSED in answer.lower(), "stopped": cancelled()})
    except SystemExit as e:
        emit("error", str(e))
    except Exception as e:   # un fallo no debe dejar la ventana esperando para siempre
        traceback.print_exc()
        emit("error", f"Error inesperado: {e}")


def theme():
    try:
        return {**DEFAULT_THEME, **json.loads(THEME.read_text())}
    except (OSError, ValueError):
        return dict(DEFAULT_THEME)


def note_uri(path):
    return "obsidian://open?" + urllib.parse.urlencode({"vault": tc.VAULT.name, "file": path},
                                                      quote_via=urllib.parse.quote)


# ── ventana ────────────────────────────────────────────────────────────────
def gui(argv):
    import gi
    gi.require_version("Gtk", "3.0")
    gi.require_version("Gdk", "3.0")
    gi.require_version("WebKit2", "4.1")
    from gi.repository import Gdk, Gio, GLib, Gtk, WebKit2

    page = (WEB / "index.html").as_uri()

    class App(Gtk.Application):
        def __init__(self):
            super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE)
            self.window = self.view = None
            self.ready, self.pending = False, []
            self.busy = False
            self.cancel = threading.Event()

        def do_command_line(self, cmdline):
            args = cmdline.get_arguments()[1:]
            if self.window is None:
                self.build()
            self.window.present()
            if len(args) >= 2 and args[0] == "--ask":
                self.js("Copilot.askNew", " ".join(args[1:]).strip())
            return 0

        def build(self):
            manager = WebKit2.UserContentManager()
            manager.register_script_message_handler("copilot")
            manager.connect("script-message-received::copilot", self.on_message)
            self.view = WebKit2.WebView.new_with_user_content_manager(manager)
            self.view.get_settings().set_enable_developer_extras(False)
            rgba = Gdk.RGBA()
            rgba.parse(theme()["surface"])
            self.view.set_background_color(rgba)   # sin destello blanco al abrir
            self.view.connect("decide-policy", self.on_policy)
            self.view.connect("context-menu", lambda *_: True)
            self.view.load_uri(page)
            self.window = Gtk.ApplicationWindow(application=self, title="Trucha Copilot")
            self.window.set_default_size(1100, 760)
            self.window.add(self.view)
            self.window.show_all()

        def js(self, fn, *args):
            code = f"{fn}({', '.join(json.dumps(a, ensure_ascii=False) for a in args)})"
            if not self.ready:
                self.pending.append(code)
            else:
                self.view.evaluate_javascript(code, -1, None, None, None, None, None)

        def on_policy(self, _view, decision, kind):
            if kind == WebKit2.PolicyDecisionType.RESPONSE:
                return False
            uri = decision.get_navigation_action().get_request().get_uri()
            if kind == WebKit2.PolicyDecisionType.NAVIGATION_ACTION and uri.split("#")[0] == page:
                return False
            # nada se abre dentro de la ventana: los enlaces van al navegador u Obsidian
            if uri.startswith(("http://", "https://", "obsidian://")):
                Gio.AppInfo.launch_default_for_uri(uri, None)
            decision.ignore()
            return True

        def on_message(self, _manager, result):
            value = result.get_js_value() if hasattr(result, "get_js_value") else result
            msg = json.loads(value.to_string())
            cmd = msg.get("cmd")
            db = store()
            if cmd == "ready":
                self.ready = True
                self.view.evaluate_javascript(
                    f"Copilot.init({json.dumps({'theme': theme(), 'chats': list_chats(db)}, ensure_ascii=False)})",
                    -1, None, None, None, None, None)
                for code in self.pending:
                    self.view.evaluate_javascript(code, -1, None, None, None, None, None)
                self.pending.clear()
            elif cmd == "open":
                self.js("Copilot.showChat", msg["chat"], messages(db, msg["chat"]))
            elif cmd == "delete":
                delete_chat(db, msg["chat"])
                self.js("Copilot.setChats", list_chats(db))
            elif cmd == "send" and not self.busy and msg.get("text", "").strip():
                self.send(db, msg.get("chat"), msg["text"].strip(), bool(msg.get("think")))
            elif cmd == "stop":
                self.cancel.set()
            elif cmd == "source":
                Gio.AppInfo.launch_default_for_uri(note_uri(msg["path"]), None)
            elif cmd == "copy":
                Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD).set_text(msg["text"], -1)

        def send(self, db, chat, text, think):
            if not chat:
                chat = new_chat(db, text)
                self.js("Copilot.chatCreated", chat, list_chats(db))
            self.busy = True
            self.cancel.clear()

            def emit(kind, data):
                GLib.idle_add(self.js, "Copilot.event", chat, kind, data)

            def work():
                try:
                    run_turn(chat, text, think, emit, self.cancel.is_set)
                finally:
                    GLib.idle_add(self.finish)

            threading.Thread(target=work, daemon=True).start()

        def finish(self):
            self.busy = False
            self.js("Copilot.setChats", list_chats(store()))

    GLib.set_prgname(APP_ID)
    return App().run(argv)


if __name__ == "__main__":
    if len(sys.argv) > 1 and sys.argv[1] in ("-h", "--help"):
        print(__doc__)
        sys.exit(0)
    sys.exit(gui(sys.argv))
