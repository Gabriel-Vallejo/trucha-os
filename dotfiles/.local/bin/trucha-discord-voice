#!/usr/bin/env python3
"""trucha-discord-voice — puente entre el RPC local de Discord y el widget truchaDiscord de la barra.

  trucha-discord-voice            servicio: mantiene $XDG_RUNTIME_DIR/trucha-discord.json al día
  trucha-discord-voice mute|deaf  cambia micrófono o sonido
  trucha-discord-voice setup      guarda las credenciales de tu aplicación de Discord

Solo habla con el socket local de Discord y con su API OAuth2. Credenciales en
~/.config/trucha-os/discord-rpc.json (permisos 600, fuera del repo): client_id y client_secret."""
import getpass
import json
import os
import select
import socket
import struct
import sys
import threading
import time
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

HOME = Path.home()
RUNTIME = Path(os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}")
CONFIG = HOME / ".config/trucha-os/discord-rpc.json"
TOKEN = HOME / ".local/state/trucha-os/discord-token.json"
STATE = RUNTIME / "trucha-discord.json"
COMMANDS = RUNTIME / "trucha-discord.sock"

TOKEN_URL = "https://discord.com/api/oauth2/token"
REDIRECT_URI = "http://127.0.0.1"
SCOPES = ["rpc", "rpc.voice.read", "rpc.voice.write"]
CHANNEL_EVENTS = ["VOICE_STATE_CREATE", "VOICE_STATE_UPDATE", "VOICE_STATE_DELETE", "SPEAKING_START", "SPEAKING_STOP"]
OP_HANDSHAKE, OP_FRAME, OP_CLOSE, OP_PING, OP_PONG = range(5)
MAX_FRAME = 1 << 20
WAIT = 5
ACTIONS = {"mute", "deaf"}


class ConfigError(Exception):
    pass


class AuthError(Exception):
    pass


class RpcError(Exception):
    pass


def backoff(error):
    # un rechazo no debe volver a abrir la ventana de Discord cada pocos segundos
    return 300 if isinstance(error, (AuthError, ConfigError)) else WAIT


def load_config():
    if not CONFIG.exists():
        raise ConfigError(f"falta {CONFIG}")
    if CONFIG.stat().st_mode & 0o077:
        raise ConfigError(f"{CONFIG} debe tener permisos 600")
    try:
        config = json.loads(CONFIG.read_text())
        if not (config["client_id"] and config["client_secret"]):
            raise KeyError
    except (ValueError, KeyError, TypeError):
        raise ConfigError(f"{CONFIG} necesita client_id y client_secret") from None
    return config


def write_private(path, data):
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(".tmp")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as fh:
        json.dump(data, fh, ensure_ascii=False)
    os.replace(tmp, path)


def token_request(fields, config):
    body = urllib.parse.urlencode({**fields, "client_id": config["client_id"],
                                   "client_secret": config["client_secret"]}).encode()
    # sin User-Agent propio, Cloudflare corta a Python-urllib con un 403
    request = urllib.request.Request(TOKEN_URL, body, {"User-Agent": "trucha-discord-voice/1.0",
                                                       "Content-Type": "application/x-www-form-urlencoded"})
    try:
        with urllib.request.urlopen(request, timeout=15) as response:
            return json.load(response)
    except urllib.error.HTTPError as e:
        try:
            reason = json.load(e).get("error", e.code)
        except ValueError:
            reason = e.code
        raise AuthError(f"Discord rechazó el token: {reason}") from None


def save_token(token):
    token["expires_at"] = time.time() + token.get("expires_in", 0)
    write_private(TOKEN, token)
    return token


def load_token():
    try:
        return json.loads(TOKEN.read_text())
    except (OSError, ValueError):
        return None


def member(entry):
    user, voice = entry.get("user") or {}, entry.get("voice_state") or {}
    return {"id": str(user.get("id", "")),
            "name": entry.get("nick") or user.get("global_name") or user.get("username") or "?",
            "mute": bool(voice.get("mute") or voice.get("self_mute")),
            "deaf": bool(voice.get("deaf") or voice.get("self_deaf")),
            "speaking": False}


def empty_state(error=""):
    return {"connected": False, "inVoice": False, "channel": "", "mute": False, "deaf": False,
            "members": [], "error": error}


def apply_event(state, evt, data):
    """Actualiza el estado con un evento de Discord. Devuelve el estado nuevo."""
    members = state["members"]
    if evt in ("VOICE_STATE_CREATE", "VOICE_STATE_UPDATE"):
        new = member(data)
        old = next((m for m in members if m["id"] == new["id"]), None)
        new["speaking"] = bool(old and old["speaking"])
        members = [new if m["id"] == new["id"] else m for m in members] if old else [*members, new]
    elif evt == "VOICE_STATE_DELETE":
        gone = str((data.get("user") or {}).get("id", ""))
        members = [m for m in members if m["id"] != gone]
    elif evt in ("SPEAKING_START", "SPEAKING_STOP"):
        who = str(data.get("user_id", ""))
        members = [{**m, "speaking": evt == "SPEAKING_START"} if m["id"] == who else m for m in members]
    elif evt == "VOICE_SETTINGS_UPDATE":
        return {**state, "mute": bool(data.get("mute")), "deaf": bool(data.get("deaf"))}
    return {**state, "members": members}


class Rpc:
    """Tramas del socket de Discord: op y longitud en little-endian, y JSON."""

    def __init__(self, sock):
        self.sock = sock
        self.buffer = b""
        self.nonce = 0

    def write(self, op, body):
        data = json.dumps(body).encode()
        self.sock.sendall(struct.pack("<II", op, len(data)) + data)

    def _fill(self, size):
        while len(self.buffer) < size:
            chunk = self.sock.recv(65536)
            if not chunk:
                raise ConnectionError("Discord cerró la conexión")
            self.buffer += chunk

    def pending(self):
        if len(self.buffer) < 8:
            return False
        return len(self.buffer) >= 8 + struct.unpack("<II", self.buffer[:8])[1]

    def read(self):
        self._fill(8)
        op, size = struct.unpack("<II", self.buffer[:8])
        if size > MAX_FRAME:
            raise ConnectionError("trama demasiado grande")
        self._fill(8 + size)
        body = json.loads(self.buffer[8:8 + size])
        self.buffer = self.buffer[8 + size:]
        if op == OP_PING:
            self.write(OP_PONG, body)
            return None
        if op == OP_CLOSE:
            raise ConnectionError(f"Discord cerró: {body.get('message', '')}")
        return body


def connect_discord():
    for n in range(10):
        for base in (RUNTIME, RUNTIME / "app/com.discordapp.Discord"):
            path = base / f"discord-ipc-{n}"
            if path.exists():
                sock = socket.socket(socket.AF_UNIX)
                try:
                    sock.connect(str(path))
                    return sock
                except OSError:
                    sock.close()
    raise ConnectionError("Discord no está abierto")


class Bridge:
    def __init__(self, sock, config):
        self.rpc = Rpc(sock)
        self.config = config
        self.state = empty_state()
        self.channel_id = None
        self.resync_needed = False

    def publish(self):
        write_private(STATE, self.state)

    def call(self, cmd, args=None, evt=None):
        self.rpc.nonce += 1
        nonce = str(self.rpc.nonce)
        message = {"cmd": cmd, "nonce": nonce, "args": args or {}}
        if evt:
            message["evt"] = evt
        self.rpc.write(OP_FRAME, message)
        while True:
            body = self.rpc.read()
            if body is None:
                continue
            if body.get("nonce") != nonce:
                self.handle(body)
                continue
            if body.get("evt") == "ERROR":
                data = body.get("data") or {}
                raise RpcError(f"{data.get('code')}: {data.get('message')}")
            return body.get("data") or {}

    def handle(self, body):
        evt = body.get("evt")
        if evt == "VOICE_CHANNEL_SELECT":
            self.resync_needed = True
        elif evt:
            self.state = apply_event(self.state, evt, body.get("data") or {})
            self.publish()

    def authorize(self):
        try:
            code = self.call("AUTHORIZE", {"client_id": self.config["client_id"], "scopes": SCOPES})["code"]
        except RpcError as e:
            raise AuthError(f"autorización rechazada ({e})") from None
        return save_token(token_request({"grant_type": "authorization_code", "code": code,
                                         "redirect_uri": REDIRECT_URI}, self.config))

    def login(self):
        token = load_token()
        if token and token.get("expires_at", 0) < time.time() + 60:
            try:
                token = save_token(token_request({"grant_type": "refresh_token",
                                                  "refresh_token": token.get("refresh_token", "")}, self.config))
            except AuthError:
                token = None
        token = token or self.authorize()
        try:
            self.call("AUTHENTICATE", {"access_token": token["access_token"]})
        except RpcError:
            token = self.authorize()
            try:
                self.call("AUTHENTICATE", {"access_token": token["access_token"]})
            except RpcError as e:
                raise AuthError(f"Discord rechazó el acceso ({e})") from None

    def resync(self):
        self.resync_needed = False
        channel = self.call("GET_SELECTED_VOICE_CHANNEL") or {}
        new_id = channel.get("id")
        if new_id != self.channel_id:
            for evt in CHANNEL_EVENTS:
                if self.channel_id:
                    self.call("UNSUBSCRIBE", {"channel_id": self.channel_id}, evt)
                if new_id:
                    self.call("SUBSCRIBE", {"channel_id": new_id}, evt)
            self.channel_id = new_id
        self.state = {**self.state, "inVoice": bool(new_id), "channel": channel.get("name") or "",
                      "members": [member(v) for v in channel.get("voice_states") or []]}
        self.publish()

    def start(self):
        self.rpc.write(OP_HANDSHAKE, {"v": 1, "client_id": str(self.config["client_id"])})
        while (self.rpc.read() or {}).get("evt") != "READY":
            pass
        self.login()
        self.state = {**self.state, "connected": True}
        for evt in ("VOICE_CHANNEL_SELECT", "VOICE_SETTINGS_UPDATE"):
            self.call("SUBSCRIBE", {}, evt)
        self.state = apply_event(self.state, "VOICE_SETTINGS_UPDATE", self.call("GET_VOICE_SETTINGS"))
        self.resync()

    def action(self, name):
        if name in ACTIONS:
            self.state = apply_event(self.state, "VOICE_SETTINGS_UPDATE",
                                     {**{k: self.state[k] for k in ACTIONS},
                                      **self.call("SET_VOICE_SETTINGS", {name: not self.state[name]})})
            self.publish()

    def serve(self, commands, stop):
        while not stop.is_set():
            if self.resync_needed:
                self.resync()
            if self.rpc.pending():
                self.handle(self.rpc.read() or {})
                continue
            ready, _, _ = select.select([self.rpc.sock, commands], [], [], 1)
            if self.rpc.sock in ready:
                self.handle(self.rpc.read() or {})
            if commands in ready:
                conn, _ = commands.accept()
                with conn:
                    conn.settimeout(1)
                    self.action(conn.recv(16).decode(errors="ignore").strip())


def command_socket():
    COMMANDS.unlink(missing_ok=True)
    server = socket.socket(socket.AF_UNIX)
    server.bind(str(COMMANDS))
    COMMANDS.chmod(0o600)
    server.listen()
    return server


def run(stop=None):
    stop = stop or threading.Event()
    commands = command_socket()
    while not stop.is_set():
        sock = None
        try:
            config = load_config()
            sock = connect_discord()
            bridge = Bridge(sock, config)
            bridge.start()
            bridge.serve(commands, stop)
            return
        except (ConfigError, AuthError, RpcError, ConnectionError, OSError, ValueError) as error:
            write_private(STATE, empty_state(str(error)))
            print(f"trucha-discord-voice: {error}", file=sys.stderr, flush=True)
            time.sleep(backoff(error))
        finally:
            if sock:
                sock.close()
            if stop.is_set():
                write_private(STATE, empty_state())


def send_command(name):
    if name not in ACTIONS:
        print("uso: trucha-discord-voice [mute|deaf]", file=sys.stderr)
        return 2
    with socket.socket(socket.AF_UNIX) as sock:
        try:
            sock.connect(str(COMMANDS))
            sock.sendall(name.encode())
        except OSError:
            print("el servicio trucha-discord-voice no está activo", file=sys.stderr)
            return 1
    return 0


def setup():
    client_id = input("Application ID: ").strip()
    secret = getpass.getpass("Client Secret (no se muestra): ").strip()
    if not client_id.isdigit() or not secret:
        print("datos no válidos: no se ha guardado nada", file=sys.stderr)
        return 1
    write_private(CONFIG, {"client_id": client_id, "client_secret": secret})
    TOKEN.unlink(missing_ok=True)
    print(f"guardado en {CONFIG}")
    return 0


if __name__ == "__main__":
    if sys.argv[1:] == ["setup"]:
        sys.exit(setup())
    if len(sys.argv) > 1:
        sys.exit(send_command(sys.argv[1]))
    run()
