#!/usr/bin/env bash
# fondo — fondos animados de Wallpaper Engine en COSMIC (linux-wallpaperengine)
#   fondo            arranca el fondo por defecto (torii)
#   fondo <nombre>   arranca ~/.local/share/wallpaperengine/wallpapers/<nombre> o un ID del workshop de Windows
#   fondo stop       para el fondo animado (se queda la imagen fija)
#   fondo list       lista los fondos disponibles
LWE=/opt/linux-wallpaperengine
DATA="$HOME/.local/share/wallpaperengine"
# Windows se monta en /run/media (Arch) o en /media (Ubuntu/Pop)
WIN_WS=$(ls -d /run/media/"$USER"/*/"Program Files (x86)/Steam/steamapps/workshop/content/431960" \
               /media/"$USER"/*/"Program Files (x86)/Steam/steamapps/workshop/content/431960" 2>/dev/null | head -1)
OUTPUT="${FONDO_OUTPUT:-eDP-1}"
# sin argumento: el fondo del tema activo de Trucha OS! (trucha-theme)
DEFAULT=$(python3 -I -c 'import json,os;print(json.load(open(os.path.expanduser("~/.config/trucha-os/themes/"+json.load(open(os.path.expanduser("~/.config/trucha-os/current.json")))["id"]+".json")))["wallpaper"])' 2>/dev/null || echo torii)

case "${1:-$DEFAULT}" in
  stop) pkill -f "^$LWE/linux-wallpaperengine" && echo "Fondo animado parado"; exit 0 ;;
  list)
    echo "Locales:"; ls "$DATA/wallpapers"
    if [ -d "$WIN_WS" ]; then
      echo; echo "Workshop (Windows):"
      for d in "$WIN_WS"/*/; do
        python3 -I -c 'import json,sys;j=json.load(open(sys.argv[1]+"project.json"));print(sys.argv[1].rstrip("/").split("/")[-1], "-", j.get("title"))' "$d" 2>/dev/null
      done
    fi
    exit 0 ;;
esac

bg="$DATA/wallpapers/${1:-$DEFAULT}"
[ -d "$bg" ] || bg="$WIN_WS/$1"
[ -d "$bg" ] || { echo "No encuentro el fondo '$1' (prueba: fondo list)"; exit 1; }

# propiedades de la escena que fija el tema que usa este fondo ("wallpaper_properties"), p. ej. apagar su reloj
props=()
while IFS= read -r p; do props+=(--set-property "$p"); done < <(python3 -I -c '
import glob, json, os, sys
for f in glob.glob(os.path.expanduser("~/.config/trucha-os/themes/*.json")):
    t = json.load(open(f, encoding="utf-8"))
    if t.get("wallpaper") == sys.argv[1]:
        for k, v in t.get("wallpaper_properties", {}).items():
            print(f"{k}={int(v) if isinstance(v, bool) else v}")
' "${1:-$DEFAULT}" 2>/dev/null)

pkill -f "^$LWE/linux-wallpaperengine"
LD_LIBRARY_PATH="$LWE:$LWE/lib" exec "$LWE/linux-wallpaperengine" \
  --assets-dir "$DATA/assets" --silent --fps 30 --disable-mouse \
  --layer background --screen-root "$OUTPUT" --bg "$bg" --scaling fill "${props[@]}"
