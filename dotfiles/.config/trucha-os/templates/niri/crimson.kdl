// ─── Crimson Ink · niri ─────────────────────────────────────
// Se incluye al final de config.kdl, así que manda sobre lo que genera DMS.
// Documentación: ~/.local/src/crimson-ink/niri/docs/wiki

input {
    keyboard {
        xkb {
            layout "es"
            options "lv3:ralt_switch,compose:rctrl"
        }
        repeat-delay 300
        repeat-rate 40
        numlock
    }
    touchpad {
        tap
        dwt
        natural-scroll
        accel-speed 0.15
        scroll-factor 0.6
    }
    mouse {
        accel-profile "flat"
    }
    focus-follows-mouse max-scroll-amount="0%"
    workspace-auto-back-and-forth
}

output "eDP-1" {
    mode "2560x1600"
    scale 1.5
    variable-refresh-rate on-demand=true
}

layout {
    gaps 12
    center-focused-column "on-overflow"
    always-center-single-column
    background-color "transparent"

    default-column-width { proportion 0.5; }
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 1.0
    }

    focus-ring {
        width 2
        active-gradient from="#e5383b" to="#ff5a5f" angle=135 relative-to="workspace-view"
        inactive-color "#26262b"
        urgent-color "#e8b04b"
    }
    border {
        off
    }
    shadow {
        on
        softness 34
        spread 4
        offset x=0 y=8
        color "#000000a0"
        inactive-color "#00000060"
    }
    tab-indicator {
        active-color "#e5383b"
        inactive-color "#4a4a52"
        width 4
        gap 6
        corner-radius 4
    }
    insert-hint {
        color "#e5383b66"
    }
}

blur {
    passes 3
    offset 4
    noise 0.03
    saturation 1.3
}

overview {
    zoom 0.45
    backdrop-color "#060607"
    workspace-shadow {
        softness 40
        spread 8
        offset x=0 y=10
        color "#000000b0"
    }
}

cursor {
    xcursor-theme "Bibata-Modern-Classic"
    xcursor-size 24
    hide-when-typing
    hide-after-inactive-ms 4000
}

screenshot-path "~/Imágenes/Capturas/%Y-%m-%d_%H-%M-%S.png"

environment {
    XDG_CURRENT_DESKTOP "niri"
    ELECTRON_OZONE_PLATFORM_HINT "auto"
    QT_QPA_PLATFORM "wayland;xcb"
    QT_QPA_PLATFORMTHEME "qt6ct"
    XCURSOR_THEME "Bibata-Modern-Classic"
    XCURSOR_SIZE "24"
    // Ghidra, Burp, DataGrip… (Java/XWayland) salen en blanco sin esto
    _JAVA_AWT_WM_NONREPARENTING "1"
    // escribir en japonés (fcitx5 + Mozc): Qt por el protocolo de Wayland, XWayland por XIM;
    // GTK usa text-input-v3 sin variables (GTK_IM_MODULE no se pone a propósito)
    QT_IM_MODULES "wayland;fcitx"
    XMODIFIERS "@im=fcitx"
}

// Fondo animado (Torii) con linux-wallpaperengine
spawn-at-startup "systemctl" "--user" "restart" "trucha-fondo.service"
// ventanas flotantes en todos los escritorios: solo las que fijes con Win+G (Win+Shift+T las pone flotantes)
spawn-at-startup "niri-float-sticky" "-disable-auto-stick"
// método de entrada: Ctrl+Alt+Espacio alterna español ⇄ japonés (Mozc)
spawn-at-startup "fcitx5" "-d" "--replace"

// Shaders de ventana: corte de katana al abrir, se deshace en brasas al cerrar,
// aberración roja al redimensionar. Los colores van premultiplicados por alfa.
animations {
    // Tajo de katana: la hoja cruza la ventana en el primer 15 %, destello,
    // y la ventana sale partida en dos mitades que se cierran sobre una grieta al rojo.
    window-open {
        duration-ms 560
        curve "linear"
        custom-shader r#"
            vec4 open_color(vec3 coords_geo, vec3 size_geo) {
                float p = niri_clamped_progress;
                vec3 rojo = vec3(0.898, 0.220, 0.231);
                vec3 brasa = vec3(1.0, 0.45, 0.30);

                // geometría en píxeles; el tajo sube hacia la derecha y pasa por el centro
                vec2 centro = size_geo.xy * 0.5;
                vec2 rel = coords_geo.xy * size_geo.xy - centro;
                vec2 dir = normalize(vec2(1.0, -0.42));
                vec2 nor = vec2(-dir.y, dir.x);
                float largo = length(size_geo.xy);
                float dist = dot(rel, nor);
                float lado = dist < 0.0 ? -1.0 : 1.0;
                float a_lo_largo = clamp(dot(rel, dir) / largo + 0.5, 0.0, 1.0);

                // mitades: separadas 36 px y desplazadas por el tajo; se cierran con ease-out-expo
                float q = clamp((p - 0.15) / 0.85, 0.0, 1.0);
                // normalizado para que en q = 1 encajen exactas, sin costura
                float e = (1.0 - pow(2.0, -9.0 * q)) / (1.0 - pow(2.0, -9.0));
                float sep = 36.0 * (1.0 - e);
                vec2 origen = rel - lado * (nor * sep + dir * 0.06 * largo * (1.0 - e));
                vec2 uv = (origen + centro) / size_geo.xy;
                float dist_origen = dot(origen, nor);
                vec4 color = vec4(0.0);
                if (uv.x >= 0.0 && uv.x <= 1.0 && uv.y >= 0.0 && uv.y <= 1.0 && dist_origen * lado >= 0.0) {
                    color = texture2D(niri_tex, (niri_geo_to_tex * vec3(uv, 1.0)).st);
                }
                float calor = 1.0 - smoothstep(0.15, 0.75, p);
                // bordes del corte al rojo vivo, se enfrían con el calor
                float filo = exp(-abs(dist_origen) / 5.0) * calor;
                color.rgb = mix(color.rgb, brasa * color.a, filo);
                float destello = exp(-pow((p - 0.15) * 30.0, 2.0)) * 0.25;
                color.rgb += destello * color.a;
                color *= smoothstep(0.13, 0.2, p);

                // grieta: luz roja entre las dos mitades
                float grieta = exp(-abs(dist) / (sep * 0.5 + 2.0)) * calor * step(0.15, p);
                vec4 luz = vec4(rojo * grieta, grieta * 0.9);

                // hoja: crece de punta a punta, más gruesa en el centro que en los extremos
                float g = 1.0 - pow(1.0 - clamp(p / 0.15, 0.0, 1.0), 3.0);
                float grosor = sin(3.14159 * a_lo_largo);
                float trazo = step(a_lo_largo, g) * (1.0 - smoothstep(0.15, 0.32, p));
                float nucleo = exp(-abs(dist) / (0.6 + 2.2 * grosor)) * trazo;
                float halo = exp(-abs(dist) / (4.0 + 12.0 * grosor)) * trazo * 0.9;
                float punta = exp(-abs(a_lo_largo - g) * 25.0) * exp(-abs(dist) / 5.0) * (1.0 - step(1.0, g));
                vec3 hoja = vec3(1.0) * (nucleo + punta) + rojo * halo;
                float a_hoja = clamp(nucleo + halo + punta, 0.0, 1.0);
                luz = vec4(hoja, a_hoja) + luz * (1.0 - a_hoja);

                vec4 salida = luz + color * (1.0 - luz.a);
                salida.a = min(salida.a, 1.0);
                salida.rgb = min(salida.rgb, vec3(salida.a));
                return salida;
            }
        "#
    }
    window-close {
        duration-ms 460
        curve "ease-out-quad"
        custom-shader r#"
            float hash(vec2 p) { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }

            vec4 close_color(vec3 coords_geo, vec3 size_geo) {
                float p = niri_clamped_progress;
                vec3 rojo = vec3(0.898, 0.220, 0.231);

                // ruido en bloques de 6 px + gradiente: se deshace de arriba abajo
                float ruido = hash(floor(coords_geo.xy * size_geo.xy / 6.0) + niri_random_seed * 53.0);
                float t = ruido * 0.6 + coords_geo.y * 0.4;
                float frente = p * 1.1 - 0.05;
                if (t < frente) return vec4(0.0);

                vec4 color = texture2D(niri_tex, (niri_geo_to_tex * coords_geo).st);
                // brasa roja justo en el borde que se quema
                float brasa = 1.0 - smoothstep(0.0, 0.07, t - frente);
                color.rgb = mix(color.rgb, rojo * color.a, brasa);
                return color * (1.0 - 0.3 * p);
            }
        "#
    }
    window-resize {
        custom-shader r#"
            vec4 muestra(sampler2D tex, mat3 geo_to_tex, vec3 c, float s) {
                vec4 centro = texture2D(tex, (geo_to_tex * c).st);
                centro.r = texture2D(tex, (geo_to_tex * (c + vec3(s, 0.0, 0.0))).st).r;
                return centro;
            }

            vec4 resize_color(vec3 coords_curr_geo, vec3 size_curr_geo) {
                float p = niri_clamped_progress;
                // separación del canal rojo que crece a mitad de animación
                float s = sin(p * 3.14159) * 6.0 / size_curr_geo.x;
                vec4 antes = muestra(niri_tex_prev, niri_geo_to_tex_prev, niri_curr_geo_to_prev_geo * coords_curr_geo, s);
                vec4 despues = muestra(niri_tex_next, niri_geo_to_tex_next, niri_curr_geo_to_next_geo * coords_curr_geo, s);
                return mix(antes, despues, p);
            }
        "#
    }
}

// ─── Reglas de ventana ──────────────────────────────────────
window-rule {
    geometry-corner-radius 14
    clip-to-geometry true
    draw-border-with-background false
}

// Ventanas sin foco ligeramente apagadas
window-rule {
    match is-active=false
    opacity 0.94
}

// Modo exhibición: ocupa toda la pantalla
window-rule {
    match app-id="^trucha-showcase$"
    open-maximized true
    background-effect {
        blur true
    }
}

// Terminal translúcido con blur
window-rule {
    match app-id="^kitty$"
    background-effect {
        blur true
    }
}

window-rule {
    match app-id=r#"^com\.system76\.Cosmic(Settings|Edit)$"#
    match app-id="^org.gnome.Nautilus$"
    default-column-width { proportion 0.5; }
}

window-rule {
    match app-id="^xdg-desktop-portal"
    match title="^Picture-in-Picture$"
    match title="^Imagen con imagen$"
    open-floating true
}

window-rule {
    match app-id="^google-chrome$"
    match app-id="^code$"
    match app-id=r#"^jetbrains-"#
    default-column-width { proportion 0.66667; }
}

// Fondo de pantalla dentro del backdrop: se ve detrás del overview
layer-rule {
    match namespace="^wallpaper"
    match namespace="^linux-wallpaperengine"
    place-within-backdrop true
}

// (DMS pide su propio blur con la forma exacta de cada panel vía ext-background-effect)

// ─── Atajos propios (además de los de DMS: Mod+/ los muestra todos) ──
binds {
    Alt+F4 repeat=false hotkey-overlay-title="Cerrar ventana" { close-window; }
    // === Atajos estilo Windows (sobrescriben los de dms/binds.kdl) ===
    Mod+L repeat=false hotkey-overlay-title="Bloquear (Win+L)" { spawn "dms" "ipc" "call" "lock" "lock"; }
    Mod+D repeat=false hotkey-overlay-title="Vista general (Win+D)" { toggle-overview; }
    Mod+Shift+D hotkey-overlay-title="Dash" { spawn "dms" "ipc" "call" "dash" "toggle" ""; }
    Mod+R hotkey-overlay-title="Ejecutar (Win+R)" { spawn "dms" "ipc" "call" "spotlight" "toggle"; }
    Mod+S hotkey-overlay-title="Buscar (Win+S)" { spawn "dms" "ipc" "call" "spotlight" "toggle"; }
    Mod+Ctrl+W { switch-preset-column-width; }
    Mod+I hotkey-overlay-title="Configuración (Win+I)" { spawn "dms" "ipc" "call" "settings" "focusOrToggle"; }
    Mod+N hotkey-overlay-title="Notificaciones (Win+N)" { spawn "dms" "ipc" "call" "notifications" "toggle"; }
    Mod+Ctrl+N hotkey-overlay-title="Notepad" { spawn "dms" "ipc" "call" "notepad" "toggle"; }
    Ctrl+Shift+Escape hotkey-overlay-title="Administrador de tareas" { spawn "dms" "ipc" "call" "processlist" "focusOrToggle"; }
    Mod+Print hotkey-overlay-title="Captura pantalla completa (Win+ImpPnt)" { spawn "dms" "screenshot" "full"; }
    Mod+Up repeat=false hotkey-overlay-title="Maximizar (Win+Arriba)" { maximize-window-to-edges; }
    Mod+Down repeat=false hotkey-overlay-title="Restaurar (Win+Abajo)" { maximize-window-to-edges; }
    Mod+Ctrl+Left hotkey-overlay-title="Escritorio anterior" { focus-workspace-up; }
    Mod+Ctrl+Right hotkey-overlay-title="Escritorio siguiente" { focus-workspace-down; }
    Mod+Ctrl+D hotkey-overlay-title="Nuevo escritorio (Win+Ctrl+D)" { spawn "__HOME__/.local/bin/niri-nuevo-escritorio"; }
    Mod+Shift+Left hotkey-overlay-title="Mover a monitor izquierdo" { move-column-to-monitor-left; }
    Mod+Shift+Right hotkey-overlay-title="Mover a monitor derecho" { move-column-to-monitor-right; }
    Mod+Alt+Left { move-column-left; }
    Mod+Alt+Right { move-column-right; }
    Mod+Return hotkey-overlay-title="Terminal (kitty)" { spawn "__HOME__/.local/bin/kitty"; }
    Mod+E hotkey-overlay-title="Archivos" { spawn "nautilus" "--new-window"; }
    Mod+B hotkey-overlay-title="Navegador" { spawn "google-chrome-stable"; }
    Mod+C hotkey-overlay-title="VS Code" { spawn "code"; }
    Mod+Shift+Space hotkey-overlay-title="Competis (ciberseguridad y hackatones)" { spawn "dms" "ipc" "call" "spotlight" "toggleQuery" "@ "; }
    Mod+Alt+T hotkey-overlay-title="Cambiar de tema (Trucha OS!)" { spawn "dms" "ipc" "call" "spotlight" "toggleQuery" "% "; }
    Mod+Alt+Return hotkey-overlay-title="Modo exhibición (fetch · cava · reloj · btop)" { spawn "__HOME__/.local/bin/trucha-showcase"; }
    Mod+Shift+W hotkey-overlay-title="Reiniciar fondo animado" { spawn "systemctl" "--user" "restart" "trucha-fondo.service"; }
    Mod+Shift+S hotkey-overlay-title="Captura de región" { screenshot; }
    Mod+Shift+X hotkey-overlay-title="OCR de una zona al portapapeles" { spawn "sh" "-c" "exec ~/.local/bin/trucha-ocr"; }
    Shift+Print hotkey-overlay-title="Quick Capture (anotar, grabar, OCR, QR)" { spawn "dms" "ipc" "call" "quickCapture" "toggle"; }
    Mod+G hotkey-overlay-title="Fijar ventana flotante en todos los escritorios" { spawn "niri-float-sticky" "-ipc" "toggle_sticky"; }
    Print { screenshot-screen; }
}
