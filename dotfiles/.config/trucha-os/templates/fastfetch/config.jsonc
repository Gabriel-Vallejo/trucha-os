// Crimson Ink — fastfetch
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/torii.txt",
    "color": { "1": "38;2;229;56;59", "2": "38;2;228;223;218", "3": "38;2;74;74;82" },
    "padding": { "top": 1, "left": 2, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "38;2;229;56;59", "title": "38;2;229;56;59" },
    "key": { "width": 12 }
  },
  "modules": [
    { "type": "custom", "format": "\u001b[1;38;2;229;56;59m󰈺  Trucha OS!\u001b[0;38;2;74;74;82m  ·  crimson ink" },
    { "type": "title", "format": "{user-name-colored}{at-symbol-colored}{host-name-colored}" },
    { "type": "custom", "format": "\u001b[38;2;74;74;82m────────────────────────────────" },
    { "type": "os", "key": "󰈺  os" },
    { "type": "kernel", "key": "  kernel" },
    { "type": "de", "key": "  de" },
    { "type": "wm", "key": "  wm" },
    { "type": "shell", "key": "  shell" },
    { "type": "terminal", "key": "  term" },
    { "type": "custom", "format": "\u001b[38;2;74;74;82m────────────────────────────────" },
    { "type": "cpu", "key": "  cpu" },
    { "type": "gpu", "key": "󰢮  gpu", "hideType": "integrated" },
    { "type": "memory", "key": "  mem" },
    { "type": "disk", "key": "󰋊  disk", "folders": "/" },
    { "type": "battery", "key": "  bat" },
    { "type": "uptime", "key": "󰅐  up" },
    "break",
    { "type": "colors", "symbol": "circle", "paddingLeft": 2 }
  ]
}
