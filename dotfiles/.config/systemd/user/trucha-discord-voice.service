[Unit]
Description=Trucha OS! — puente de voz de Discord para la barra
PartOf=graphical-session.target
After=graphical-session.target
ConditionPathExists=%h/.config/trucha-os/discord-rpc.json

[Service]
Type=simple
ExecStart=%h/.local/bin/trucha-discord-voice
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
