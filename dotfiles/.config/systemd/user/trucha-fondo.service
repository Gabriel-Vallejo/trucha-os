[Unit]
Description=Trucha OS! — fondo animado (linux-wallpaperengine) del tema activo
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
# sin argumento, fondo usa el fondo del tema activo (~/.config/trucha-os/current.json)
ExecStart=__HOME__/.local/bin/fondo
# en el arranque del login el fondo sale desplazado aunque se espere; un reinicio posterior lo centra. Una sola vez por sesión.
ExecStartPost=/bin/sh -c '[ -e %t/fondo-reiniciado ] || { touch %t/fondo-reiniciado; (sleep 20; systemctl --user restart trucha-fondo.service) >/dev/null 2>&1 & }'
Restart=on-failure
RestartSec=2
